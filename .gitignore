# Build output. Anchored to the repository root on purpose: an unanchored "gateway" also matches
# the cmd/gateway DIRECTORY, which silently kept the program's entrypoint out of every commit and
# left the published repo unable to build.
/bin/
/dist/
/gateway

# local runtime data (PVC contents)
/data/
*.db
*.db-wal
*.db-shm

# go
*.test
*.out
coverage.*

# env / secrets — never commit
.env
.env.*
*.pem
*.key
service-account.json
application_default_credentials.json

# editor / os
.DS_Store
.idea/
.vscode/
